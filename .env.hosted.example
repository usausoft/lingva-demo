# Function URL exported as PublishArtifactsApiUrl by the Lingva AWS stack.
LINGVA_DEMO_PUBLISH_API_URL=https://example.lambda-url.eu-west-1.on.aws

# Server-only delivery:write project key, CLI bearer token, or publish operator token.
LINGVA_DEMO_PUBLISH_TOKEN=

# Server-only delivery:read project key used by hosted verification.
LINGVA_DEMO_READ_API_KEY=

# Authenticated GET route served by the same Lambda URL.
LINGVA_DEMO_BUNDLE_URL_TEMPLATE=https://example.lambda-url.eu-west-1.on.aws/bundles/lingva-framework-demo/dev/latest/{locale}.bundle.json
